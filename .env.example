# ========================================================================
# バックエンド選択（既定はすべて json モック。本番で ODBC に切替）
# ========================================================================

# 受付ケースのバックエンド
#   json   : app/data/cases.json（既定）
#   access : 既存 Access DB（ACROS_NOAHフィールド情報 等）へ ODBC 接続
MAKO_CASE_BACKEND=json

# 得意先(顧客)情報のバックエンド
#   json   : app/data/customers.json（既定）
#   oracle : Oracle へ ODBC 接続
#   access : Access の得意先マスタ（A1053DB_顧客 等）へ ODBC 接続
MAKO_CUSTOMER_BACKEND=json

# 初期化失敗時に JSON へフォールバックせず例外にする(本番の設定ミス検知)
# MAKO_STRICT_BACKEND=1

# --- Access ODBC（MAKO_*_BACKEND=access のとき）---
# .accdb/.mdb のパス（VBA と同じ DB を指定）
# MAKO_ACCESS_DB=\\fileserver\CSC\NOAH.accdb
# もしくは接続文字列を直接指定
# MAKO_ACCESS_CONN=DRIVER={Microsoft Access Driver (*.mdb, *.accdb)};DBQ=C:\path\NOAH.accdb;
# ドライバ名を変える場合
# MAKO_ACCESS_DRIVER=Microsoft Access Driver (*.mdb, *.accdb)
# ケースの読み込み元（現場の集約クエリを保存した安定名を推奨。既定はテーブル名）
# MAKO_ACCESS_CASE_TABLE=ACROS_NOAHフィールド情報
# ※ 専用エラーコード列は無いため、コード検索は受付内容/問題要約/形式名へのLIKE検索
# 得意先マスタのテーブル/列
# MAKO_ACCESS_CUSTOMER_TABLE=A1053DB_顧客
# MAKO_ACCESS_CUSTOMER_ID_COL=お客様ID
# MAKO_ACCESS_CUSTOMER_NAME_COL=得意先名
# 得意先メモの追記先テーブル（用意した場合のみ。未設定だと追記不可）
# MAKO_ACCESS_CUSTOMER_NOTE_TABLE=CSC_得意先メモ

# CE(作業担当)ディレクトリ： json / access(SENS_ユーザ情報)
MAKO_ENGINEER_BACKEND=json
# MAKO_ACCESS_ENGINEER_TABLE=SENS_ユーザ情報
# MAKO_ACCESS_ENGINEER_CODE_COL=社員番号
# MAKO_ACCESS_ENGINEER_NAME_COL=氏名
# MAKO_ACCESS_ENGINEER_EMAIL_COL=メール

# --- CEディスパッチのメール送信(SMTP) ---
# 既定は送信せず下書きのみ。1 で実送信を有効化
MAKO_SMTP_ENABLED=0
# MAKO_SMTP_HOST=smtp.example.co.jp
# MAKO_SMTP_PORT=587
# MAKO_SMTP_USER=csc-dispatch@example.co.jp
# MAKO_SMTP_PASSWORD=***
# MAKO_SMTP_FROM=csc-dispatch@example.co.jp
# MAKO_SMTP_TLS=1

# --- Oracle ODBC 接続情報 (MAKO_CUSTOMER_BACKEND=oracle のとき) ---
# 接続文字列をそのまま指定(最優先)
# MAKO_ORACLE_CONN=DSN=ORCL;UID=csc;PWD=changeme
# もしくは DRIVER 直指定
# MAKO_ORACLE_CONN=DRIVER={Oracle in OraClient19Home1};DBQ=orclhost:1521/ORCLPDB;UID=csc;PWD=changeme

# あるいは DSN + UID/PWD で組み立て
# MAKO_ORACLE_DSN=ORCL
# MAKO_ORACLE_UID=csc
# MAKO_ORACLE_PWD=changeme

# 実スキーマに合わせたテーブル名の上書き(既定は例示値)
# MAKO_ORACLE_CUSTOMER_TABLE=CSC_CUSTOMERS
# MAKO_ORACLE_NOTE_TABLE=CSC_CUSTOMER_NOTES
